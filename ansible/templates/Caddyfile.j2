# When gta6_domain is set: real site with automatic Let's Encrypt TLS.
# When empty: plain HTTP on port 80 (useful before DNS is pointed).
# HSTS is intentionally NOT set until TLS is live (gta6_domain set).
#
# Static SPA served from the repo's web/ directory (matches playbook.yml
# app_dir default); the API and its docs stay reverse-proxied to FastAPI.
{% if gta6_domain | default('') %}
{{ gta6_domain }} {
    root * /opt/gta6-data/web

    @api path /api/* /health /docs /docs/* /openapi.json
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    encode gzip
    @openapi path /api/* /docs /openapi.json
    header @openapi {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
{% else %}
:80 {
    root * /opt/gta6-data/web

    @api path /api/* /health /docs /docs/* /openapi.json
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    encode gzip
    @openapi path /api/* /docs /openapi.json
    header @openapi {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
{% endif %}
