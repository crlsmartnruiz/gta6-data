# When gta6_domain is set: real site with automatic Let's Encrypt TLS.
# When empty: plain HTTP on port 80 (useful before DNS is pointed).
# HSTS is intentionally NOT set until TLS is live (gta6_domain set).
{% if gta6_domain | default('') %}
{{ gta6_domain }} {
    reverse_proxy 127.0.0.1:8000
    encode gzip
    @openapi path /api/* /docs /openapi.json
    header @openapi {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
{% else %}
:80 {
    reverse_proxy 127.0.0.1:8000
    encode gzip
    @openapi path /api/* /docs /openapi.json
    header @openapi {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
{% endif %}
